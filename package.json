{
  "name": "timetable-builder",
  "version": "0.1.0",
  "description": "Evidence-first timetable-to-calendar builder with PDF, text, and URL intake, clash detection, human approval, audit history, and Excel, Word, PDF, and ICS exports.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:api": "node scripts/verify-run-api.mjs",
    "test:samples": "node scripts/verify-timetable-samples.mjs",
    "test:scenarios": "node test-scenarios.mjs",
    "test:all": "npm run lint && npx tsc --noEmit && npm run test:scenarios && npm run test:api && npm run test:samples",
    "evidence:demo": "node scripts/capture-demo-evidence.mjs",
    "test:live-sources": "node scripts/verify-live-sources.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/react": "^7.1.3",
    "@fullcalendar/timegrid": "^6.1.22",
    "cheerio": "^1.2.0",
    "docx": "^9.12.0",
    "exceljs": "^4.4.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
